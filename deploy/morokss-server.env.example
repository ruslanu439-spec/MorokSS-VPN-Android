MOROKSS_SECRET=replace-with-output-of-openssl-rand-base64-48
# MOROKSS_PREVIOUS_SECRET=old-secret-used-only-during-key-rotation
SC_LISTEN=0.0.0.0:443
SC_BACKEND=127.0.0.1:8388
SC_DECOY=127.0.0.1:8080
SC_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
SC_KEY=/etc/letsencrypt/live/example.com/privkey.pem
